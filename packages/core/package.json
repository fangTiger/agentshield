{
  "name": "@agentshield/core",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./chain": {
      "types": "./dist/chain/index.d.ts",
      "default": "./dist/chain/index.js"
    },
    "./chain/encoding": {
      "types": "./dist/chain/encoding.d.ts",
      "default": "./dist/chain/encoding.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node -e \"for (const file of ['auth/phrases.yaml', 'scan/redlines.yaml']) require('node:fs').copyFileSync('src/' + file, 'dist/' + file)\"",
    "test": "vitest run",
    "intel:sync": "node scripts/sync-intel.mjs",
    "intel:eval": "node scripts/evaluate-intel.mjs",
    "chain:abi": "node src/chain/export-abi.mjs"
  },
  "dependencies": {
    "@semaphore-protocol/group": "4.14.5",
    "@semaphore-protocol/identity": "4.14.5",
    "@semaphore-protocol/proof": "4.14.5",
    "jsqr": "^1.4.0",
    "sharp": "0.35.5",
    "tar": "^7.5.23",
    "tldts": "^7.5.5",
    "viem": "2.58.6",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/yauzl": "^3.4.0",
    "qrcode": "^1.5.4"
  }
}
